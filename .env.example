HOST=0.0.0.0
PORT=8787
DATABASE_PATH=./data/remote.db
PAIR_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_SECRET=replace-with-at-least-32-random-characters
CODEX_HOME=
CODEX_SESSIONS_DIR=
# JSON array; defaults to ["app-server"]
CODEX_ARGS=["app-server"]
CODEX_COMMAND=codex
# Semicolon-separated on Windows, colon-separated on macOS/Linux
# Defaults to [process.cwd(), home directory] if not set
CODEX_CWD_ALLOWLIST=
CODEX_APP_SERVER_CWD=E:\Codex Remote APP
CODEX_REQUEST_TIMEOUT_MS=30000
VITE_API_URL=
