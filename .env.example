HOST=0.0.0.0
PORT=8787
DATABASE_PATH=./data/remote.db
PAIR_CODE_TTL_SECONDS=300
# Optional. When set, clients can pair by entering this password instead of a
# one-time code. Password-paired devices persist across service restarts, so a
# phone reconnects automatically once the host comes back online.
PAIR_PASSWORD=
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30
# Optional. Leave empty to persist an automatically generated secret beside DATABASE_PATH.
TOKEN_SECRET=
CODEX_HOME=
CODEX_SESSIONS_DIR=
# JSON array; defaults to ["app-server"]
CODEX_ARGS=["app-server"]
CODEX_COMMAND=codex
# Semicolon-separated on Windows, colon-separated on macOS/Linux
# Defaults to [process.cwd(), home directory] if not set
CODEX_CWD_ALLOWLIST=
CODEX_APP_SERVER_CWD=E:\Codex Remote APP
CODEX_REQUEST_TIMEOUT_MS=30000
VITE_API_URL=
